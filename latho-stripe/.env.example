# Use a restricted API key (rk_test_...) in development; see README for the permissions it needs.
# Never commit real keys. In production, load these from your host's secrets vault.
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Product tax code for cleaning services. Pick it from https://docs.stripe.com/tax/tax-codes
# (or the Tax Codes API) and confirm with your accountant; it is not hardcoded on purpose.
STRIPE_TAX_CODE=

PUBLIC_BASE_URL=http://localhost:4242
# Long random string; crews/office send it as "Authorization: Bearer <token>".
ADMIN_TOKEN=replace_with_a_long_random_string
PORT=4242
